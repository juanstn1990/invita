# Copia esto a `.env` y ajústalo. `.env` no se versiona.

# ── La base ─────────────────────────────────────────────────────
# Postgres. En local la levanta `docker compose up -d db`, en 5433 para no
# chocar con otro Postgres que pueda haber en el 5432.
DATABASE_URL=postgres://invita:invita@localhost:5433/invita?sslmode=disable
#
# En EasyPanel es el host interno del servicio de base de datos:
#   DATABASE_URL=postgres://usuario:clave@proyecto_servicio:5432/invita?sslmode=disable

# ── La biblioteca de imágenes ───────────────────────────────────
# Dónde viven los archivos que se suben. Por defecto `uploads/` dentro del
# proyecto, que está en .gitignore: cómodo para empezar, frágil para
# conservar. Apuntarlo fuera es la diferencia entre tener copia y no tenerla.
#
#   en WSL:      UPLOADS_DIR=/mnt/c/Users/Public/Invita/biblioteca
#   en un VPS:   UPLOADS_DIR=/data/biblioteca      (un volumen montado ahí)
UPLOADS_DIR=/mnt/c/Users/Public/Invita/biblioteca

# ── Respaldos ───────────────────────────────────────────────────
# A dónde escriben `npm run backup` y `npm run docker:backup`.
BACKUP_DIR=/mnt/c/Users/Public/Invita/respaldos

# ── El servidor MCP ─────────────────────────────────────────────
# La llave de `/api/mcp`, por donde un asistente crea y edita invitaciones.
# **Sin ella la ruta está apagada** (503), que es el estado correcto por
# defecto: son herramientas de escritura y una dirección pública que las
# ofrezca sin credencial es un formulario abierto al que llegue.
#
#   openssl rand -hex 32
#
# MCP_TOKEN=
#
# Con qué dirección se arman los enlaces que devuelve el MCP.
# INVITA_URL=https://tuinvitacion.simpplee.com
